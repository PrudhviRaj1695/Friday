# Keep the worker on loopback unless you deliberately need phone-to-PC LAN access.
FRIDAY_HOST=127.0.0.1
FRIDAY_PORT=8765

# Required when FRIDAY_HOST is 0.0.0.0 or another non-loopback interface.
FRIDAY_API_TOKEN=replace-with-a-long-random-secret

OLLAMA_URL=http://127.0.0.1:11434
FRIDAY_MODEL=qwen2.5:3b
COMFYUI_URL=http://127.0.0.1:8188
FRIDAY_WORKFLOWS_DIR=./workflows
FRIDAY_OUTPUT_DIR=./data/media
FRIDAY_DATABASE_PATH=./data/friday.db
FRIDAY_PROVIDER_TIMEOUT=900
FRIDAY_JOB_POLL_INTERVAL=1.5
